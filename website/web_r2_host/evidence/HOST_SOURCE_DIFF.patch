-# VHS v0.6 four-layer platform - start the local service on 127.0.0.1:8775 (background).
-# Usage:  powershell -ExecutionPolicy Bypass -File run_vhs.ps1 [-Port 8775] [-Foreground]
-# Stop:   powershell -ExecutionPolicy Bypass -File stop_vhs.ps1
-# Ports 8772 (v0.4), 8773 (v0.5) and 8774 (v0.5.1) are never touched.
-#
-# Note: Start-Process can fail on hosts whose environment contains both NO_PROXY
-# and no_proxy (PowerShell 5.1 duplicate-key bug).  This script therefore creates
-# the detached process through WMI Win32_Process.Create, which is not affected.
-param([int]$Port = 8775, [switch]$Foreground)
-$ErrorActionPreference = 'Stop'
-$App = Split-Path -Parent $MyInvocation.MyCommand.Path
-$candidates = @(
-  $env:VHS_PYTHON,
-  'C:\Users\Administrator\.dsh\dsh-runtimes\dsh-primary-runtime\dependencies\python\python.exe',
-  'C:\Users\Administrator\.workbuddy-ai\binaries\python\versions\3.13.12\python.exe'
-) | Where-Object { $_ -and (Test-Path -LiteralPath $_) }
-$Py = $null
-foreach ($c in $candidates) { if (-not $Py) { $Py = $c } }
-if (-not $Py) {
-  $cmd = Get-Command python -ErrorAction SilentlyContinue
-  if ($cmd) { $Py = $cmd.Source }
-}
-if (-not $Py) { throw "python not found; set VHS_PYTHON to python.exe" }
-if ($Port -in 8772, 8773, 8774) { throw "port $Port belongs to v0.4/v0.5/v0.5.1; refusing" }
-$busy = Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue
-if ($busy) { throw "port $Port already in use by PID $($busy[0].OwningProcess)" }
-$Logs = Join-Path $App 'logs'
-$Tmp = Join-Path $App 'tmp'
-New-Item -ItemType Directory -Force -Path $Logs, $Tmp | Out-Null
-$env:TEMP = $Tmp; $env:TMP = $Tmp; $env:PYTHONDONTWRITEBYTECODE = '1'; $env:PYTHONIOENCODING = 'utf-8'
-$srv = Join-Path $App 'server.py'
-$outLog = Join-Path $Logs "server_$Port.out.log"
-$errLog = Join-Path $Logs "server_$Port.err.log"
-if ($Foreground) { & $Py -B $srv --port $Port; exit $LASTEXITCODE }
-$line = 'cmd.exe /c ""' + $Py + '" -B "' + $srv + '" --port ' + $Port + ' > "' + $outLog + '" 2> "' + $errLog + '""'
-$created = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = $line; CurrentDirectory = $App }
-if ($created.ReturnValue -ne 0) { throw "Win32_Process.Create failed rc=$($created.ReturnValue)" }
-$ok = $false
-for ($i = 0; $i -lt 120; $i++) {
-  Start-Sleep -Milliseconds 500
-  try { $r = Invoke-RestMethod -Uri "http://127.0.0.1:$Port/api/vhs/health" -TimeoutSec 2; $ok = $true; break } catch {}
-}
-if (-not $ok) { "start failed; see $errLog"; exit 1 }
-$owner = Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue
-if ($owner) { Set-Content -LiteralPath (Join-Path $Logs "server_$Port.pid") -Value $owner[0].OwningProcess -Encoding ascii }
-"VHS v$($r.app_version) PID=$($owner[0].OwningProcess) URL=http://127.0.0.1:$Port/"
-"  layers=$($r.four_layer -join ',')  model_execution=$($r.model_execution)  prediction=$($r.prediction)"
-"  SYRDARYA=$($r.datasets.SYRDARYA)  LAMAHCE=$($r.datasets.LAMAHCE)"
+# R2 candidate wrapper; original release launcher is preserved in its historical directory.
+param([int]$Port=8792)
+if($Port -ne 8792){throw 'This candidate is restricted to 8792.'}
+& (Join-Path (Split-Path -Parent $PSScriptRoot) 'start_host.ps1')
